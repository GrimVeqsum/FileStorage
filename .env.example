# Local development placeholders only. Replace before exposing the API.
# Existing volumes retain their original credentials; do not reset the volumes.
HTTP_PORT=8080
HTTP_BIND_ADDRESS=127.0.0.1

POSTGRES_DB=file_storage
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me-local-db-password
# Compose network hostname. Keep credentials aligned with POSTGRES_* above.
# URL-encode reserved characters when changing the password in this URL.
DATABASE_URL=postgres://postgres:replace-me-local-db-password@postgres:5432/file_storage?sslmode=disable

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=local-filestorage
MINIO_SECRET_KEY=replace-me-local-minio-password
MINIO_BUCKET=files
MINIO_USE_SSL=false

# File bytes; multipart framing gets a separate bounded 1 MiB allowance.
MAX_FILE_SIZE_MB=20
